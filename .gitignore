# Dependencies
node_modules

# The project uses pnpm; a lockfile from another package manager would drift from pnpm-lock.yaml.
package-lock.json
yarn.lock

# Build output and caches
dist
dist-ssr
coverage
*.tsbuildinfo

# Environment files stay on the machine; .env.example documents the variables
.env
.env.*
!.env.example
*.local

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor and OS files
.vscode/*
!.vscode/extensions.json
.idea
.claude/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
